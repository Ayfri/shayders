{
	"name": "shayders",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"typegen-db": "bunx pocketbase-typegen -j ./pb_schema.json --out ./src/lib/pocketbase-types.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20261003.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"pocketbase-typegen": "^1.5.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.51.0",
		"monaco-editor": "^0.57.0",
		"pocketbase": "^0.28.1"
	},
	"imports": {
		"#components/*": "./src/lib/components/*",
		"#features/*": "./src/lib/features/*",
		"#lib/*": "./src/lib/*"
	}
